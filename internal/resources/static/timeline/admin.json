                                                "label": "ID",
                                                "value": "id"
                                            },
                                            {
                                                "label": "分组",
                                                "value": "group_id"
                                            },
                                            {
                                                "label": "子分组",
                                                "value": "subgroup_id"
                                            },
                                            {
                                                "label": "开始时间",
                                                "value": "start"
                                            },
                                            {
                                                "label": "结束时间",
                                                "value": "end"
                                            }
